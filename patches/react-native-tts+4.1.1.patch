+// This module used to declare its own `buildscript { repositories { jcenter() } }`
+// block pinning an ancient com.android.tools.build:gradle:1.3.1 classpath — jcenter()
+// no longer exists as a repository method on current Gradle, so that block failed
+// outright before Gradle could even get to resolving anything. It's also unnecessary:
+// every other autolinked native module's build.gradle in this app applies
+// 'com.android.library' without declaring its own AGP classpath, relying on the one
+// already on the root project's buildscript classpath — removing this block (instead
+// of just swapping jcenter() for mavenCentral()) avoids a second failure mode where
+// mavenCentral() doesn't have that 2015-era AGP version published either.
 apply plugin: 'com.android.library'
 
 android {

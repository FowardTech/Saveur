<?xml version="1.0" encoding="utf-8"?>
<!-- MainActivity's windowBackground — light gray (@color/splash_background)
     with the Saveur logo centered at a fixed, known size we fully control.
     Deliberately NOT
     using the system SplashScreen API's windowSplashScreenAnimatedIcon for
     this logo (see Theme.App.SplashScreen in styles.xml, which now sets no
     icon at all) — that mechanism was tried twice with well-padded assets
     and still rendered the logo huge/cropped on-device, seemingly ignoring
     the source PNG's own transparent padding. A plain windowBackground
     drawable has no such platform-side auto-sizing: this <item>'s
     width/height directly control the on-screen box.

     @mipmap/ic_launcher_foreground is used as the source (not a separate
     splash_logo asset) — it has ~62% content occupancy (the new logo's own
     safe-zone padding). Box size below (248dp) is chosen so the actual
     visible glyph still renders at the same ~154dp this was previously
     tuned to (248 * 0.62 ≈ 154), same moderate size as before — only the
     asset and background color changed (new blue-S logo on light gray,
     replacing the old white-on-blue mark), not the on-screen scale that
     was already verified to sit clear of the screen edges. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item android:gravity="center" android:width="248dp" android:height="248dp">
        <bitmap android:src="@mipmap/ic_launcher_foreground" android:gravity="center" />
    </item>
</layer-list>

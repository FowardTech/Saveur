<?xml version="1.0" encoding="utf-8"?>
<!-- MainActivity's windowBackground — plain blue with the Saveur logo
     centered at a fixed, known size we fully control. Deliberately NOT
     using the system SplashScreen API's windowSplashScreenAnimatedIcon for
     this logo (see Theme.App.SplashScreen in styles.xml, which now sets no
     icon at all) — that mechanism was tried twice with well-padded assets
     and still rendered the logo huge/cropped on-device, seemingly ignoring
     the source PNG's own transparent padding. A plain windowBackground
     drawable has no such platform-side auto-sizing: this <item>'s
     width/height directly control the on-screen box.

     @mipmap/ic_launcher_foreground is used as the source (not a separate
     splash_logo asset) because it already has generous transparent padding
     baked in (~46% content occupancy, from the adaptive-icon safe-zone fix)
     — sized into a 336dp box here so the actual visible glyph renders at
     roughly 154dp, a more moderate size than the original 480dp box/~220dp
     glyph (~70% scale-down, matching the equivalent reduction made to the
     iOS LaunchScreen.storyboard logo) — the full-size mark read as too
     dominant on the splash screen (verified by compositing this exact box
     size over a mock phone canvas before committing — the glyph still sits
     well clear of the screen edges, nothing cropped). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item android:gravity="center" android:width="336dp" android:height="336dp">
        <bitmap android:src="@mipmap/ic_launcher_foreground" android:gravity="center" />
    </item>
</layer-list>

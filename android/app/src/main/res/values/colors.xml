<resources>
    <!-- Brand splash/launch background — see styles.xml's AppTheme
         android:windowBackground. Previously unset, so the very first frame
         before RN loads fell back to Theme.AppCompat.DayNight's own default
         (near-black in dark mode, which is what showed up as a black splash
         on-device) instead of a deliberate brand color.

         Was changed from flat brand blue (#0063f8) to a light gray (#F4F4F4)
         when the logo mark was blue (a blue mark would have disappeared
         against a blue splash). Product request ("I want the Saveur app
         icon to be the default app blue background and the S shaped design
         in the middle to be color white... the splashscreen will have to
         change back to blue background") — back to brand blue now that the
         mark itself has been recolored white (assets/bootsplash/logo*.png,
         ic_launcher_foreground.png) to read against it. -->
    <color name="splash_background">#0063f8</color>
    <!-- Tint applied to the white notification-icon silhouette
         (drawable-*dpi/ic_stat_saveur.png) on API 21+ — see
         AndroidManifest.xml's default_notification_icon/_color meta-data
         and services/pushNotificationService.ts's matching smallIcon.
         Same brand blue as splash_background above. -->
    <color name="notification_icon_color">#0063f8</color>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (API 26+) — takes over from the flat mipmap-*/ic_launcher.png
     files on devices/launchers new enough to support it, letting the OEM
     launcher mask the icon into whatever shape it uses (circle, squircle,
     rounded square, etc.) instead of always showing our own square crop. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>

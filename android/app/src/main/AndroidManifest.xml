<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- First-open, one-time location-based language detection — see
         utils/locationLanguage.ts. Coarse only (country-level accuracy is
         all that's needed to pick a language). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- The AppsFlyer SDK's own manifest (com.appsflyer:af-android-sdk)
         declares android:allowBackup="true", which conflicts with our
         explicit "false" below and fails the release build's manifest
         merge otherwise ("Attribute application@allowBackup value=(false)
         ... is also present at [com.appsflyer:af-android-sdk] ...
         value=(true)"). tools:replace tells the merger our app's value
         wins — deliberately "false", since allowBackup="true" lets Android
         back up (and restore, on a new device) app data/prefs via
         adb backup / cloud backup, which we don't want for a security-
         sensitive app. -->
    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      tools:replace="android:allowBackup"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:theme="@style/Theme.App.SplashScreen"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <!-- MainActivity is now the LAUNCHER directly — there used to be a
             separate SplashActivity shown first for a fixed 900ms, then
             handed off to this ReactActivity via startActivity(). Even with
             matching visuals, that handoff is a real Activity transition
             (its own window creation/animation), which is what actually
             read as "an extra splash screen" — not just a color mismatch.
             Removing the extra Activity entirely means there is exactly one
             screen now, not two that happen to look similar.

             Theme.App.SplashScreen (not AppTheme.Main directly) is the
             theme here because targetSdkVersion 36 makes Android's own
             system SplashScreen (API 31+) mandatory — left unconfigured, it
             auto-derives an icon from the launcher icon with its own
             padding assumptions, which was rendering the logo blown up
             edge-to-edge/cropped (a second, OS-level "extra splash" on top
             of everything above). That icon mechanism proved unreliable
             even with explicit, well-padded assets, so Theme.App.SplashScreen
             (styles.xml) now shows no icon at all — just the plain
             @color/splash_background — and hands off immediately to
             AppTheme.Main, which shows the actual
             logo via a plain windowBackground drawable instead (full manual
             control over its size, not subject to the system splash icon
             pipeline) — see MainActivity.kt's installSplashScreen() call. -->
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!-- Matches returnURL: 'saveur://stripe-redirect' in
             services/billingService.ts's initPaymentSheet call — lets
             Android hand control back to the app after a payment method
             that redirects out (bank auth, 3D Secure).
             autoVerify left off since this scheme isn't a real https://
             App Link needing domain verification. -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="saveur" />
        </intent-filter>
        <!-- App Links (product request item: shared links open the app
             directly instead of a browser tab), Android's equivalent of
             iOS Universal Links (see caren_family.entitlements' matching
             associated-domains entry). autoVerify="true" makes Android
             fetch https://<host>/.well-known/assetlinks.json
             (Saveur-Backend's app/web.py) at install time, per host listed
             below, to confirm this app is allowed to claim these paths;
             that file's sha256_cert_fingerprints is still blank until the
             release keystore's fingerprint is set (see
             ANDROID_SHA256_FINGERPRINT in web.py), so verification will
             silently fail and Android will fall back to the plain saveur://
             scheme above until then; nothing regresses, this just isn't
             fully live yet.
             share.saveurnow.com added alongside api.saveurnow.com (NOT
             replacing it): product/security concern, job/referral share
             links were showing "api." in the URL bar to recipients,
             exposing backend naming, so new links now use this dedicated
             share.saveurnow.com subdomain instead (see
             jobShareService.ts's WEB_SHARE_BASE_URL / referralService.ts
             and Saveur-Backend's PUBLIC_SHARE_BASE_URL). Keeping
             api.saveurnow.com listed too means any link already shared
             before this change keeps opening the app directly. Multiple
             data elements inside one intent-filter are combined
             (Android's own docs: "all the data elements are combined into
             a full pattern set"), so both hosts are verified/matched by
             this single filter; no need for a second intent-filter. -->
        <intent-filter android:autoVerify="true">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" android:host="api.saveurnow.com" />
            <data android:scheme="https" android:host="share.saveurnow.com" />
        </intent-filter>
        <!-- OS Share Sheet integration (product request: "Ability to share
             files to Saveur from the device and it will go directly to the
             document section of the app") — lets Saveur appear as a share
             target from Files, Mail, a browser's "Share" menu, etc., for a
             single file (ACTION_SEND) or several at once
             (ACTION_SEND_MULTIPLE). Reuses this same singleTask
             MainActivity rather than a separate share-only Activity — a
             dedicated ShareActivity is the more common pattern for apps
             that want a lightweight "confirm and dismiss" share UI
             (finish() immediately after handling the intent), but this
             app's product ask is specifically "it will go directly to the
             document section of the app" — i.e. land the user inside the
             real app, on My Documents, with the shared file already queued
             for upload, not a transient dialog. See ShareIntentModule.kt
             for how the shared content:// URI(s) get resolved into real
             local files and handed to JS, and services/shareIntentService.ts
             for how the JS side picks this up and navigates to My
             Documents.
             mimeType intentionally broad (*/*) rather than enumerating
             specific types (application/pdf, image/*, etc., each needing
             its own <data> element) — My Documents' own manual upload
             picker (src/more/MyDocuments.tsx's onUpload, via
             @react-native-documents/picker) already accepts pdf/doc/docx/
             plainText/images, and this share path is meant to mirror that,
             not be more restrictive about what a user can share in from
             another app. -->
        <intent-filter android:label="@string/app_name">
            <action android:name="android.intent.action.SEND" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="*/*" />
        </intent-filter>
        <intent-filter android:label="@string/app_name">
            <action android:name="android.intent.action.SEND_MULTIPLE" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="*/*" />
        </intent-filter>
      </activity>
      <!-- BUG FIX (product report: "the icon for the push notification is
           still showing the old one instead of the new icon"): this only
           covers FOREGROUND pushes (see services/pushNotificationService.ts's
           own notifee.displayNotification call, smallIcon: 'ic_stat_saveur').
           A background/killed-state push with a real notification block is
           displayed automatically by Firebase's own SDK with zero JS code
           running, and without this meta-data it falls back to
           @mipmap/ic_launcher (the full-color, fully-opaque app icon):
           same "renders as a plain white block, not the S mark" problem
           Android's always-silhouette status-bar rendering causes for any
           opaque icon, regardless of which logo era it's from. Points at
           the same proper white-on-transparent notification icon
           (drawable-*dpi/ic_stat_saveur.png) so background/killed pushes
           match foreground ones instead of silently falling back to a
           different, wrong asset. Color matches this app's one brand blue
           (see constants/theme/appTheme.json's color-primary-500):
           Android tints a silhouette small-icon with this color on API 21+
           instead of leaving it plain white. -->
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_icon"
        android:resource="@drawable/ic_stat_saveur" />
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_color"
        android:resource="@color/notification_icon_color" />
    </application>
</manifest>

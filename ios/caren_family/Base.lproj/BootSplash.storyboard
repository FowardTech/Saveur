<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="21701" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
    <device id="retina4_7" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="21678"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController modalTransitionStyle="crossDissolve" id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" autoresizesSubviews="NO" contentMode="scaleToFill" id="Ze5-6b-2t3">
                        <rect key="frame" x="0.0" y="0.0" width="375" height="667"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <!-- Product request ("I want the splash screen to be like
                                 [reference]... The saveur logo and the app name will be
                                 on the same horizontal level") — was the logo mark alone.
                                 Positioned/sized identically to LaunchScreen.storyboard's own
                                 row (1/3-up-from-bottom, same 56x52 mark + "Saveur" label,
                                 same 10pt spacing) so this native BootSplash view — which
                                 RNBootSplash keeps on screen after the OS-driven LaunchScreen
                                 dismisses, until JS calls hide() — reads as a seamless
                                 continuation of it rather than a second, visually distinct
                                 splash screen. Same "plain wrapping row, sized from its own
                                 children's pinned edges, no width/height of its own" Auto
                                 Layout pattern as LaunchScreen.storyboard's own row — see
                                 that file's matching comment for the full reasoning. -->
                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="SavRow01B">
                                <rect key="frame" x="112" y="405" width="151" height="52"/>
                                <subviews>
                                    <imageView autoresizesSubviews="NO" clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" image="BootSplashLogo-32fdd7" translatesAutoresizingMaskIntoConstraints="NO" id="3lX-Ut-9ad">
                                        <rect key="frame" x="0.0" y="0.0" width="56" height="52"/>
                                        <constraints>
                                            <constraint firstAttribute="width" constant="56" id="SavIW01"/>
                                            <constraint firstAttribute="height" constant="52" id="SavIW02"/>
                                        </constraints>
                                        <accessibility key="accessibilityConfiguration">
                                            <accessibilityTraits key="traits" image="YES" notEnabled="YES"/>
                                        </accessibility>
                                    </imageView>
                                    <!-- Same MontserratAlternates-Black "Saveur" wordmark as
                                         LaunchScreen.storyboard's own row label — see that
                                         file's matching comment. -->
                                    <label opaque="NO" clipsSubviews="YES" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Saveur" textAlignment="left" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="SavLbl01B">
                                        <rect key="frame" x="66" y="6" width="85" height="40"/>
                                        <fontDescription key="fontDescription" name="MontserratAlternates-Black" family="Montserrat Alternates" pointSize="28"/>
                                        <color key="textColor" red="1" green="1" blue="1" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                        <nil key="highlightedColor"/>
                                    </label>
                                </subviews>
                                <constraints>
                                    <constraint firstItem="3lX-Ut-9ad" firstAttribute="leading" secondItem="SavRow01B" secondAttribute="leading" id="SavC01B"/>
                                    <constraint firstItem="3lX-Ut-9ad" firstAttribute="top" secondItem="SavRow01B" secondAttribute="top" id="SavC02B"/>
                                    <constraint firstItem="3lX-Ut-9ad" firstAttribute="bottom" secondItem="SavRow01B" secondAttribute="bottom" id="SavC03B"/>
                                    <constraint firstItem="SavLbl01B" firstAttribute="leading" secondItem="3lX-Ut-9ad" secondAttribute="trailing" constant="10" id="SavC04B"/>
                                    <constraint firstItem="SavLbl01B" firstAttribute="centerY" secondItem="SavRow01B" secondAttribute="centerY" id="SavC05B"/>
                                    <constraint firstItem="SavRow01B" firstAttribute="trailing" secondItem="SavLbl01B" secondAttribute="trailing" id="SavC06B"/>
                                </constraints>
                            </view>
                            <!-- Same footer credit line as LaunchScreen.storyboard, same white
                                 (back to matching that file's restored blue background — see
                                 the git history on this comment and on LaunchScreen.storyboard's
                                 equivalent label), so the handoff between the two storyboards is
                                 invisible to the user. -->
                            <label opaque="NO" clipsSubviews="YES" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="By Foward Technologies Inc." textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" minimumFontSize="9" translatesAutoresizingMaskIntoConstraints="NO" id="MN2-I3-ftu">
                                <rect key="frame" x="0.0" y="626" width="375" height="21"/>
                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                <color key="textColor" red="1" green="1" blue="1" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                <nil key="highlightedColor"/>
                            </label>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="Bcu-3y-fUS"/>
                        <color key="backgroundColor" name="BootSplashBackground-32fdd7"/>
                        <constraints>
                            <constraint firstItem="SavRow01B" firstAttribute="centerX" secondItem="Ze5-6b-2t3" secondAttribute="centerX" id="Fh9-Fy-1nT"/>
                            <constraint firstItem="SavRow01B" firstAttribute="centerY" secondItem="Ze5-6b-2t3" secondAttribute="bottom" multiplier="1/3" constant="1" id="nvB-Ic-PnI"/>
                            <constraint firstItem="Bcu-3y-fUS" firstAttribute="bottom" secondItem="MN2-I3-ftu" secondAttribute="bottom" constant="20" id="OZV-Vh-mqD"/>
                            <constraint firstItem="MN2-I3-ftu" firstAttribute="centerX" secondItem="Ze5-6b-2t3" secondAttribute="centerX" id="akx-eg-2ui"/>
                            <constraint firstItem="MN2-I3-ftu" firstAttribute="leading" secondItem="Bcu-3y-fUS" secondAttribute="leading" id="i1E-0Y-4RG"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iYj-Kq-Ea1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="0.0" y="0.0"/>
        </scene>
    </scenes>
    <resources>
        <image name="BootSplashLogo-32fdd7" width="100" height="92"/>
        <namedColor name="BootSplashBackground-32fdd7">

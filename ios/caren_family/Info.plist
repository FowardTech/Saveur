<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Stripe's PaymentSheet checkout (initPaymentSheet in Subscription.tsx/
	     AddOns.tsx/PaymentMethod.tsx) has no locale parameter of its own;
	     on iOS it only localizes if the app itself declares mixed-locale
	     support here. Without these two keys it silently defaults to
	     English regardless of device language. This does NOT make the
	     sheet follow the in-app language switcher (same inherent
	     before-JS-loads limitation as the splash screen); it only makes
	     it follow the device's system language, matching what Android
	     already does automatically. -->
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Saveur</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ar</string>
		<string>de</string>
		<string>es</string>
		<string>fr</string>
		<string>hi</string>
		<string>it</string>
		<string>ja</string>
		<string>ko</string>
		<string>pt</string>
		<string>ru</string>
		<string>zh</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.679326954548-35emkamsh1t03e4md0ukaqnnm19hp806</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>saveur</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>We use your camera to record video mock interviews so we can give you feedback on eye contact, expressions, and posture.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Use Face ID to sign in to Saveur quickly and securely.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Saveur may connect to devices on your local network to improve connectivity.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Saveur uses your approximate location just once, to set the app's language to the one spoken in your region. You can always change it later in Settings.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>We use your microphone to record voice and video mock interviews so we can give you feedback on your speaking.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>We save exported reports and documents to your photo library when you choose to.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>We need access to your photo library so you can upload your resume, certificates, and other documents.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>We transcribe your spoken interview answers on-device so we can give you feedback on what you said.</string>
	<key>RCTNewArchEnabled</key>
	<true/>
	<key>UIAppFonts</key>
	<array>
		<string>DCondensed-Bold.ttf</string>
		<string>GothamPro-Medium.ttf</string>
		<string>GothamPro-Regular.ttf</string>
		<string>MontserratAlternates-Black.ttf</string>
		<string>MontserratAlternates-Bold.ttf</string>
		<string>Roboto-Medium.ttf</string>
		<string>Roboto-Regular.ttf</string>
		<string>Roboto-Bold.ttf</string>
		<string>PlusJakartaSans-Regular.ttf</string>
		<string>PlusJakartaSans-Medium.ttf</string>
		<string>PlusJakartaSans-Bold.ttf</string>
	</array>
	<!-- Pruned to only what's actually used (see AppDelegate.swift /
	     package.json — @react-native-firebase/messaging for push,
	     VisionCamera/react-native-video for audio recording+playback
	     continuity). The removed modes (bluetooth-*, external-accessory,
	     nearby-interaction, push-to-talk, voip, processing, fetch,
	     location) had zero corresponding code anywhere in the app and are
	     a common App Store review rejection reason (Guideline 2.5.4 —
	     declaring background capabilities the app doesn't actually use). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>audio</string>
	</array>
	<!-- DIAGNOSTIC (round 16, see DuplexVoiceEngine.swift's
	     diagnosticRecordingFile comment): Xcode's own "Download Container"
	     feature (Devices and Simulators -> gear icon) failed with a
	     com.apple.dt.remoteservices.error transfer failure trying to pull
	     the WAV diagnostic it writes to this app's Documents folder;
	     Xcode's Download Container is known to be flaky for this exact
	     scenario. These two keys make the Documents folder show up
	     directly in the iOS Files app (On My iPhone > Saveur), so the file
	     can be shared off the device via AirDrop/Share Sheet instead,
	     without going through Xcode at all. Safe to leave on permanently,
	     since this is a standard, common flag many apps ship with, not a
	     security-sensitive one, though it can be removed once this
	     specific diagnostic is no longer needed if preferred. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>BootSplash</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>

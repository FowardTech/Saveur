<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links (product request item: shared links open the app
	     directly instead of a browser tab). This entitlement is already
	     referenced by CODE_SIGN_ENTITLEMENTS in project.pbxproj (same fix
	     that resolved the push notification entitlement issue), so no
	     further pbxproj change is needed; Xcode will pick this up on the
	     next build/reprovision the same way it did for aps-environment.
	     Each applinks: entry must match exactly a domain serving
	     /.well-known/apple-app-site-association (see Saveur-Backend's
	     app/web.py); api.saveurnow.com was confirmed against the app's
	     real production domain and signed build config (Team ID, bundle
	     id). share.saveurnow.com added alongside it (NOT replacing it):
	     product/security concern, job/referral share links were showing
	     "api." in the URL bar to recipients, exposing backend naming, so
	     new links now use this dedicated share.saveurnow.com subdomain
	     instead (see jobShareService.ts's WEB_SHARE_BASE_URL /
	     referralService.ts and Saveur-Backend's PUBLIC_SHARE_BASE_URL).
	     Keeping api.saveurnow.com listed here too means any link already
	     shared before this change keeps opening the app directly instead
	     of silently falling back to a browser tab. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:api.saveurnow.com</string>
		<string>applinks:share.saveurnow.com</string>
	</array>
	<!-- OS Share Sheet integration (product request: "Ability to share
	     files to Saveur from the device and it will go directly to the
	     document section of the app") -- an iOS Share Extension runs in
	     its own separate process/sandbox from the main app, so the only
	     way for it to hand a shared file over to Saveur itself is a
	     location BOTH processes can read/write: an App Group shared
	     container. This key must be added to BOTH this file AND the
	     extension target's own entitlements (SaveurShareExtension/
	     SaveurShareExtension.entitlements) with the exact same group id,
	     and the "App Groups" capability enabled for both targets in
	     Xcode's Signing & Capabilities tab (which is also what actually
	     registers this group id with Apple's provisioning system --
	     adding the key here by hand is necessary but not sufficient on
	     its own). See ios/SHARE_EXTENSION_SETUP.md for the full,
	     step-by-step Xcode setup this repo's own sandbox can't perform
	     (no Xcode/macOS available in this environment -- see that doc's
	     own intro). ShareIntentModule.swift (main app) reads from this
	     same container; ShareViewController.swift (extension) writes to
	     it. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.ayotundebalogun.saveur</string>
	</array>
</dict>
</plist>
